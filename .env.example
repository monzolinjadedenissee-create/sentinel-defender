# ------------------------------------------------------------------
# Sentinel environment. Copy to .env for local use, or paste these into
# your Vercel project's Environment Variables. All names are Sentinel's
# own, so this app is independent of any other project.
# ------------------------------------------------------------------

# --- Console login (REQUIRED in production) ---
# Signs the login session cookie. Use a long random string and keep it stable
# (change it and everyone is logged out). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_SECRET_KEY=change-me-to-a-long-random-string

# First admin, created once on an empty database. After the first deploy you can
# drop these and manage admins with:  python tools/create_admin.py <user> <pass>
SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASSWORD=change-me-strong-password
# How long a login lasts before re-auth (days).
SN_SESSION_DAYS=7

# --- Signal key (ingestion API your login backend calls) ---
# Guards /api/v1/signal and /api/v1/gate. Use a long random string.
SENTINEL_SIGNAL_KEY=change-me-to-another-random-string

# --- Storage: TiDB / MySQL (leave blank to use local SQLite) ---
# From your TiDB Cloud cluster's "Connect" dialog.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=sentinel
# CA bundle path used for TLS to TiDB Cloud. Vercel's runtime provides this path.
TIDB_SSL_CA=/etc/ssl/cert.pem

# --- Detection thresholds (optional; sensible defaults shown) ---
SN_FAIL_LIMIT=5
SN_FAIL_WINDOW=600
SN_BLOCK_SECONDS=900
SN_MAX_BLOCK=86400
SN_ACCOUNT_LIMIT=10
SN_LOCK_SECONDS=900
SN_RETENTION_DAYS=30

# --- Optional ---
# Discord/Slack incoming webhook for block/lock alerts.
SN_ALERT_WEBHOOK=
# Header carrying the real client IP (Vercel sets X-Forwarded-For). Trust is on automatically on Vercel.
SN_IP_HEADER=X-Forwarded-For
# SN_TRUST_PROXY=1
